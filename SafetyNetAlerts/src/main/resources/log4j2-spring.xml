<?xml version="1.0" encoding="UTF-8"?>
<Configuration>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} - %m%n"/>
        </Console>
    </Appenders>

    <Loggers>

        <!-- Nos classes SafetyNet -->
        <Logger name="com.safetynet.alerts"
                level="debug"
                additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Librairies Spring -->
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>

    </Loggers>

</Configuration>